# ─────────────────────────────────────────────────────────────
# Supabase (Browser-Safe / Public Client Configuration)
# ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ─────────────────────────────────────────────────────────────
# Server-Only Credentials — NEVER expose to the browser!
# WARNING: Do NOT add NEXT_PUBLIC_ prefix to these secret keys.
# ─────────────────────────────────────────────────────────────
SUPABASE_SERVICE_ROLE_KEY=

# ─────────────────────────────────────────────────────────────
# Access Control (Configurable Private Email Allowlist)
# Server-only variable. Comma-separated list of normalized emails.
# Whitespace is trimmed and entries are converted to lowercase.
# Empty allowlist denies all access.
# NOTE: Matching addresses must also be inserted into the
# PostgreSQL 'allowed_users' table (see supabase/seed.example.sql).
# ─────────────────────────────────────────────────────────────
APP_ALLOWED_EMAILS=owner@example.com,second-user@example.com

# Deprecated single-user compatibility variables (supported for backward compatibility):
# APP_ALLOWED_EMAIL_1=owner@example.com
# APP_ALLOWED_EMAIL_2=second-user@example.com

# ─────────────────────────────────────────────────────────────
# Cloudflare R2 Storage (Server-only credentials)
# WARNING: Do NOT expose R2_SECRET_ACCESS_KEY to the client browser!
# ─────────────────────────────────────────────────────────────
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# ─────────────────────────────────────────────────────────────
# Gemini API (Server-only credentials)
# WARNING: Do NOT expose GEMINI_API_KEY to the client browser!
# ─────────────────────────────────────────────────────────────
GEMINI_API_KEY=

# ─────────────────────────────────────────────────────────────
# App Metadata
# ─────────────────────────────────────────────────────────────
APP_TIMEZONE=Asia/Kolkata
APP_OWNER_NAME=Your Name
